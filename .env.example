NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://user:password@localhost:3306/civicfix
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAILS=admin@civicfix.local

# Compatible chat/completions API base, including its version path (usually /v1).
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# For Supabase: set STORAGE_DRIVER=s3 and use the existing PRIVATE bucket.
S3_BUCKET=civicfix-evidence
S3_REGION=ap-northeast-1
# Copy the endpoint from Supabase Storage > S3 configuration:
# https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prevent automatic empty-body checksums in browser presigned PUT URLs.
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
# S3_PUBLIC_URL is no longer used; evidence requires owner/admin authorization.

# Browser-visible key; restrict it by website/domain in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
